# ── LLM ──────────────────────────────────────────────────────────────────────
# Chave da OpenAI (opcional - deixe vazio para usar o Ollama local)
OPENAI_API_KEY=

# Modelo OpenAI a usar (padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (fallback / alternativa local) ─────────────────────────────────────
# Defina USE_OLLAMA=true para usar Ollama como primário
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b  # modelo leve, roda em notebook comum

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL da API FastAPI consumida pelo Streamlit
API_URL=http://localhost:8000
